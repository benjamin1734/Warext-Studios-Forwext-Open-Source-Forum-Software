{
  "schema_version": 1,
  "policy_id": "forwext.third_party_dependencies",
  "roadmap_step": "01.05",
  "project_license": "Apache-2.0",
  "copyright_holder": "Warext Studios",
  "inventory_status": "active",
  "components": [],
  "required_component_fields": [
    "name",
    "version",
    "source_url",
    "spdx_license",
    "scope",
    "redistributed",
    "notice_required",
    "security_advisory_url",
    "maintainer_status",
    "last_reviewed_at",
    "approved_by"
  ],
  "scope_values": ["runtime", "development", "build", "asset", "external_integration"],
  "license_review": {
    "normally_acceptable": ["Apache-2.0", "MIT", "BSD-2-Clause", "BSD-3-Clause", "ISC", "CC0-1.0"],
    "conditional_review": ["MPL-2.0", "LGPL-2.1-or-later", "LGPL-3.0-or-later", "GPL-3.0-or-later", "AGPL-3.0-or-later", "CC-BY-4.0"],
    "reject_by_default": ["NOASSERTION", "NONE", "UNLICENSED", "proprietary_without_permission", "noncommercial_or_no_derivatives", "unclear_provenance"]
  },
  "release_gate": {
    "unknown_license_blocks_release": true,
    "missing_required_notice_blocks_release": true,
    "untracked_redistributed_component_blocks_release": true,
    "unmitigated_known_critical_vulnerability_blocks_release": true,
    "reviewed_version_must_match_packaged_version": true
  }
}
