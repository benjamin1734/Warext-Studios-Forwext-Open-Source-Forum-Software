{
  "version": 1,
  "breakpoints": [
    {"key": "mobile", "min_width": 0, "max_width": 767},
    {"key": "tablet", "min_width": 768, "max_width": 1023},
    {"key": "desktop", "min_width": 1024, "max_width": null}
  ],
  "rules": [
    {"breakpoint": "mobile", "target": "header", "visibility": "inherit", "font_scale": 100, "spacing_scale": 80, "layout": "row"},
    {"breakpoint": "mobile", "target": "navigation", "visibility": "inherit", "font_scale": 95, "spacing_scale": 75, "layout": "stack"},
    {"breakpoint": "mobile", "target": "main", "visibility": "inherit", "font_scale": 100, "spacing_scale": 75, "layout": "auto"},
    {"breakpoint": "mobile", "target": "forum", "visibility": "inherit", "font_scale": 100, "spacing_scale": 80, "layout": "auto"},
    {"breakpoint": "mobile", "target": "profile", "visibility": "inherit", "font_scale": 100, "spacing_scale": 80, "layout": "auto"},
    {"breakpoint": "mobile", "target": "table", "visibility": "inherit", "font_scale": 90, "spacing_scale": 75, "layout": "auto"},
    {"breakpoint": "tablet", "target": "navigation", "visibility": "inherit", "font_scale": 98, "spacing_scale": 90, "layout": "row"},
    {"breakpoint": "tablet", "target": "main", "visibility": "inherit", "font_scale": 100, "spacing_scale": 90, "layout": "auto"},
    {"breakpoint": "desktop", "target": "navigation", "visibility": "inherit", "font_scale": 100, "spacing_scale": 100, "layout": "row"}
  ]
}
