{
  "name": "@forwext/react-ui",
  "version": "0.0.0-dev",
  "description": "Accessible React UI primitives and add-on extension slots for Forwext.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.3.0 <20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  }
}
